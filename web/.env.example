# Public settings only (they are compiled into the static site). Never put keys here.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=kavren.lahd-kavren.testnet
NEXT_PUBLIC_DEFAULT_AGENT=buyer-agent.lahd-kavren.testnet
# The KAVREN API, used only for the public canary opening of a finished job (optional).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Comma-separated RPC list; empty = public testnet RPCs with failover.
NEXT_PUBLIC_RPC_URLS=
