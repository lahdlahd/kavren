# KAVREN — environment variable NAMES only. Copy to .env and fill locally.
# Never commit real values. .env* is gitignored.

# --- shared ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=
KAVREN_CONTRACT_ID=
KAVREN_API_URL=

# --- api (FastAPI on Render) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
EVALUATOR_ACCOUNT_ID=
EVALUATOR_FC_PRIVATE_KEY=
AUTH_RECIPIENT=
FILE_RETENTION_DAYS=7
CORS_ORIGINS=

# --- buyer agent ---
BUYER_AGENT_ACCOUNT_ID=
BUYER_AGENT_FC_PRIVATE_KEY=
BUYER_OWNER_ACCOUNT_ID=
INBOX_DIR=./inbox
OUTBOX_DIR=./outbox

# --- provider agent ---
PROVIDER_ACCOUNT_ID=
PROVIDER_FC_PRIVATE_KEY=
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=

# --- web (Next.js on Vercel) ---
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_API_URL=

# --- Phase 0 signer check (scripts/signer_check) ---
SIGNER_CHECK_ACCOUNT_ID=
